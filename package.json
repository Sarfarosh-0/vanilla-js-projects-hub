{
  "name": "vanilla-js-projects-hub",
  "version": "1.0.0",
  "private": true,
  "description": "A curated collection of vanilla JavaScript projects for learning and open-source contributions.",
  "scripts": {
    "validate": "node scripts/validate.js",
    "build": "node scripts/build-index.js",
    "build:check": "node scripts/build-index.js --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
